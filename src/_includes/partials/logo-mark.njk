{%- set size = size or 44 -%}
<svg viewBox="0 0 80 80" width="{{ size }}" height="{{ size }}" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0 vertis-logo">
  <defs>
    <linearGradient id="vertis-v-{{ size }}" x1="6" y1="66" x2="64" y2="8" gradientUnits="userSpaceOnUse">
      <stop offset="0"    class="logo-stop logo-stop-1"/>
      <stop offset="0.55" class="logo-stop logo-stop-2"/>
      <stop offset="1"    class="logo-stop logo-stop-3"/>
    </linearGradient>
  </defs>
  {# Asymmetric V with the right arm reaching up toward the pixel trail #}
  <path d="M8 20 L30 66 L60 14" stroke="url(#vertis-v-{{ size }})" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  {# Pixel trail. Larger squares so they read at favicon and nav sizes. #}
  <g>
    <rect x="58" y="4"  width="7" height="7" fill="#00C6FF"/>
    <rect x="66" y="10" width="7" height="7" fill="#0066FF"/>
    <rect x="67" y="0"  width="6" height="6" fill="#7B2FBE"/>
    <rect x="74" y="6"  width="6" height="6" fill="#E91E63"/>
    <rect x="52" y="2"  width="5" height="5" fill="#FFCC00"/>
    <rect x="73" y="14" width="5" height="5" fill="#6DC24B"/>
    <rect x="45" y="10" width="5" height="5" fill="#FF7A1A"/>
  </g>
</svg>
