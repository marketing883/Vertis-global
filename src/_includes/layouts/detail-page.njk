---
layout: base.njk
---
{%- set pillarConfig = {
  "projects":  { num: "01", label: "Projects",         accent: "var(--color-pixel-cyan)",    parent: "/services/",         parentLabel: "All projects",            serviceType: "Technology consulting project" },
  "managed":   { num: "02", label: "Managed Services", accent: "var(--color-pixel-magenta)", parent: "/managed-services/", parentLabel: "All managed services",    serviceType: "IT managed services" },
  "staffing":  { num: "03", label: "Staffing",         accent: "var(--color-pixel-green)",   parent: "/staffing/",         parentLabel: "All staffing models",     serviceType: "IT staffing service" }
} -%}
{%- set cfg = pillarConfig[pillar] -%}

{# ============================================================
   Hero
   ============================================================ #}
<section class="section pt-20 md:pt-28 pb-16 md:pb-24">
  <div class="wrapper grid-edit">
    <div class="col-span-12">
      <h1 class="font-display font-medium text-hero leading-[0.98] tracking-[-0.035em] text-balance reveal-mask">
        <span>{{ title }}.</span>
        {% if tagline %}<span class="block italic" style="color: {{ cfg.accent }}">{{ tagline }}</span>{% endif %}
      </h1>
      {% if intro %}
        <p class="mt-8 md:mt-10 text-lg md:text-xl max-w-2xl text-ink-secondary reveal reveal-delay-2 pretty">{{ intro }}</p>
      {% endif %}
      <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-4 reveal reveal-delay-3">
        <a href="/contact/" class="btn btn-primary">
          Talk to us
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
        <a href="{{ cfg.parent }}" class="btn btn-ghost">
          {{ cfg.parentLabel }}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{# ============================================================
   Capabilities
   ============================================================ #}
{% if capabilities %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ cfg.accent }}">What we do</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ capabilitiesHeading or "What is included." }}</h2>
      {% if capabilitiesIntro %}
        <p class="mt-6 text-ink-secondary max-w-md pretty reveal reveal-delay-1">{{ capabilitiesIntro }}</p>
      {% endif %}
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <ul>
        {% for cap in capabilities %}
          <li class="reveal reveal-delay-{{ (loop.index0 % 4) + 1 }} py-8 md:py-10 border-t border-ink-primary {% if loop.last %}border-b{% endif %}">
            <h3 class="font-display font-medium text-2xl md:text-3xl leading-tight tracking-[-0.02em] flex items-start gap-3">
              <span class="shrink-0 mt-3" style="display:inline-block;width:.625rem;height:.625rem;background: {{ cfg.accent }}"></span>
              <span>{{ cap.title }}</span>
            </h3>
            <p class="mt-3 text-ink-secondary pretty pl-6">{{ cap.description }}</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

{# ============================================================
   Technologies / stack
   ============================================================ #}
{% if technologies %}
<section class="section section-statement">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-5">
      <span class="meta section-number reveal" style="--accent: {{ cfg.accent }}; color: var(--color-ink-inverse-secondary)">{{ technologiesEyebrow or "Stack" }}</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ technologiesHeading or "Tools we use most." }}</h2>
      {% if technologiesIntro %}
        <p class="mt-6 text-ink-inverse-secondary max-w-md pretty reveal reveal-delay-1">{{ technologiesIntro }}</p>
      {% endif %}
    </div>
    <div class="col-span-12 md:col-span-7 md:pl-8">
      <ul class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-4 reveal reveal-delay-2">
        {% for t in technologies %}
          <li class="flex items-center gap-2 text-sm text-ink-inverse">
            <span class="shrink-0" style="display:inline-block;width:.375rem;height:.375rem;background: {{ cfg.accent }}"></span>
            {{ t }}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

{# ============================================================
   Numbers / engagement shape
   ============================================================ #}
{% if numbers %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit items-start">
    <div class="col-span-12 md:col-span-5">
      <span class="meta section-number reveal" style="--accent: {{ cfg.accent }}">{{ numbersEyebrow or "How it works" }}</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ numbersHeading or "Engagement shape." }}</h2>
      {% if numbersIntro %}
        <p class="mt-6 text-ink-secondary max-w-md pretty reveal reveal-delay-1">{{ numbersIntro }}</p>
      {% endif %}
    </div>
    <div class="col-span-12 md:col-span-7 md:pl-8">
      <dl class="grid grid-cols-2 gap-x-8 gap-y-10 reveal reveal-delay-2">
        {% for n in numbers %}
          <div>
            <dt class="meta text-ink-secondary">{{ n.label }}</dt>
            <dd class="font-display font-medium text-3xl md:text-4xl mt-2">{{ n.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
{% endif %}

{# ============================================================
   FAQ
   ============================================================ #}
{% if faqs %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ cfg.accent }}">FAQ</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ faqsHeading or "Questions we get." }}</h2>
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <dl>
        {% for f in faqs %}
          <div class="reveal reveal-delay-{{ (loop.index0 % 4) + 1 }} py-6 md:py-8 border-t border-ink-primary {% if loop.last %}border-b{% endif %}">
            <dt class="font-display font-medium text-xl md:text-2xl leading-tight tracking-[-0.02em]">{{ f.q }}</dt>
            <dd class="mt-3 text-ink-secondary pretty max-w-3xl">{{ f.a }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
{% endif %}

{# ============================================================
   Related
   ============================================================ #}
{% if related %}
<section class="section border-t border-ink-primary">
  <div class="wrapper">
    <div class="grid-edit mb-10 md:mb-12">
      <div class="col-span-12 md:col-span-4">
        <span class="meta section-number reveal" style="--accent: {{ cfg.accent }}">Related</span>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] balance reveal">{{ relatedHeading or "See also." }}</h2>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-ink-primary border border-ink-primary">
      {% for r in related %}
        <a href="{{ r.url }}" class="bg-bg-base group block p-8 hover:bg-bg-subtle transition-colors duration-300 flex items-start justify-between gap-4 reveal reveal-delay-{{ loop.index }}">
          <div>
            <span class="meta text-ink-secondary">{{ r.kind or cfg.label }}</span>
            <div class="font-display font-medium text-2xl md:text-3xl leading-tight mt-2">{{ r.title }}</div>
            {% if r.blurb %}<p class="mt-3 text-sm text-ink-secondary pretty">{{ r.blurb }}</p>{% endif %}
          </div>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-2 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M2 8h12m0 0L9 3m5 5l-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ============================================================
   JSON-LD: Service + FAQPage schemas for SEO / AEO / GEO
   ============================================================ #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ title }}",
  "serviceType": "{{ cfg.serviceType }}",
  "description": "{{ description }}",
  "provider": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "areaServed": "Global",
  "url": "{{ site.url }}{{ page.url }}"
  {% if capabilities %},
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "{{ title }} capabilities",
    "itemListElement": [
      {% for cap in capabilities %}{
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "{{ cap.title }}",
          "description": "{{ cap.description }}"
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  {% endif %}
}
</script>

{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for f in faqs %}{
      "@type": "Question",
      "name": "{{ f.q }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ f.a }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
