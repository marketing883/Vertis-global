---
layout: base.njk
---
{%- set accent = accent or "var(--color-pixel-purple)" -%}

{# Hero #}
<section class="section pt-20 md:pt-28 pb-16 md:pb-24">
  <div class="wrapper grid-edit">
    <div class="col-span-12">
      <div class="flex flex-wrap items-center gap-3 mb-6 reveal">
        {% if industry %}<span class="meta text-ink-secondary">{{ industry }}</span>{% endif %}
        {% if year %}<span class="meta text-ink-tertiary">{{ year }}</span>{% endif %}
        {% if engagementType %}<span class="meta text-ink-tertiary">{{ engagementType }}</span>{% endif %}
      </div>
      <h1 class="font-display font-medium text-hero leading-[0.98] tracking-[-0.035em] text-balance reveal-mask">
        <span>{{ title }}.</span>
        {% if tagline %}<span class="block italic" style="color: {{ accent }}">{{ tagline }}</span>{% endif %}
      </h1>
      {% if intro %}
        <p class="mt-8 md:mt-10 text-lg md:text-xl max-w-2xl text-ink-secondary reveal reveal-delay-2 pretty">{{ intro }}</p>
      {% endif %}
    </div>
  </div>
</section>

{# Top-line metrics strip #}
{% if metrics %}
<section class="section py-14 md:py-16 border-y border-ink-primary">
  <div class="wrapper">
    <ul class="grid grid-cols-2 lg:grid-cols-{{ metrics | length }} gap-x-8 gap-y-12">
      {% for m in metrics %}
        <li class="reveal reveal-delay-{{ loop.index }}">
          <div class="meta flex items-center gap-2 mb-4 text-ink-secondary">
            <span style="display:inline-block;width:.5rem;height:.5rem;background:{{ accent }}"></span>
            <span>{{ m.label }}</span>
          </div>
          <div class="font-display font-medium text-[clamp(2.5rem,7vw,4.5rem)] leading-none tracking-[-0.04em] text-balance">{{ m.value }}</div>
          {% if m.detail %}<p class="mt-3 text-sm text-ink-secondary max-w-[22ch] pretty">{{ m.detail }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{# Challenge #}
{% if challenge %}
<section class="section">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ accent }}">01 / Challenge</span>
      <h2 class="font-display font-medium text-3xl md:text-4xl leading-tight tracking-[-0.02em] mt-6 balance reveal">{{ challengeHeading or "What was hard." }}</h2>
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <div class="reveal text-lg md:text-xl text-ink-primary pretty max-w-3xl">{{ challenge | safe }}</div>
    </div>
  </div>
</section>
{% endif %}

{# Approach #}
{% if approach %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ accent }}">02 / Approach</span>
      <h2 class="font-display font-medium text-3xl md:text-4xl leading-tight tracking-[-0.02em] mt-6 balance reveal">{{ approachHeading or "How we worked." }}</h2>
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <ol class="flex flex-col">
        {% for step in approach %}
          <li class="reveal reveal-delay-{{ loop.index }} py-6 md:py-8 border-t border-ink-primary {% if loop.last %}border-b{% endif %} grid grid-cols-12 gap-4">
            <span class="col-span-2 md:col-span-1 meta text-ink-secondary">{{ '0' + loop.index | string if loop.index < 10 else loop.index }}</span>
            <h3 class="col-span-10 md:col-span-3 font-display font-medium text-xl md:text-2xl leading-tight tracking-[-0.02em]">{{ step.title }}</h3>
            <p class="col-span-12 md:col-span-8 text-ink-secondary pretty">{{ step.description }}</p>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
{% endif %}

{# Outcome #}
{% if outcome %}
<section class="section section-statement">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ accent }}; color: var(--color-ink-inverse-secondary)">03 / Outcome</span>
      <h2 class="font-display font-medium text-3xl md:text-4xl leading-tight tracking-[-0.02em] mt-6 balance reveal">{{ outcomeHeading or "What we shipped." }}</h2>
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <div class="reveal text-lg md:text-xl text-ink-inverse pretty max-w-3xl">{{ outcome | safe }}</div>
      {% if outcomeBullets %}
        <ul class="mt-8 grid grid-cols-1 gap-y-4 reveal reveal-delay-1">
          {% for b in outcomeBullets %}
            <li class="flex items-start gap-4">
              <span class="shrink-0 mt-2" style="display:inline-block;width:.5rem;height:.5rem;background: {{ accent }}"></span>
              <span class="text-ink-inverse">{{ b }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{# Team shape #}
{% if teamShape %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ accent }}">Team shape</span>
      <h2 class="font-display font-medium text-3xl md:text-4xl leading-tight tracking-[-0.02em] mt-6 balance reveal">{{ teamShapeHeading or "Who shipped it." }}</h2>
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <dl class="grid grid-cols-2 gap-x-8 gap-y-10 reveal reveal-delay-1">
        {% for t in teamShape %}
          <div>
            <dt class="meta text-ink-secondary">{{ t.label }}</dt>
            <dd class="font-display font-medium text-2xl md:text-3xl mt-2">{{ t.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
{% endif %}

{# Services used #}
{% if servicesUsed %}
<section class="section border-t border-ink-primary">
  <div class="wrapper">
    <div class="grid-edit mb-10 md:mb-12">
      <div class="col-span-12 md:col-span-4">
        <span class="meta section-number reveal" style="--accent: {{ accent }}">Services used</span>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="font-display font-medium text-3xl md:text-4xl leading-tight tracking-[-0.02em] balance reveal">{{ servicesUsedHeading or "Everything that went in." }}</h2>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-ink-primary border border-ink-primary">
      {% for s in servicesUsed %}
        <a href="{{ s.url }}" class="bg-bg-base group block p-8 hover:bg-bg-subtle transition-colors duration-300 flex items-start justify-between gap-4 reveal reveal-delay-{{ loop.index }}">
          <div>
            <span class="meta text-ink-secondary">{{ s.kind }}</span>
            <div class="font-display font-medium text-xl md:text-2xl leading-tight mt-2">{{ s.title }}</div>
          </div>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-2 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M2 8h12m0 0L9 3m5 5l-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# JSON-LD Article schema for case study #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "author": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}{{ site.logo }}"
    }
  }{% if year %},
  "datePublished": "{{ year }}-01-01"{% endif %},
  "url": "{{ site.url }}{{ page.url }}",
  "articleSection": "Case Study"{% if industry %},
  "about": {
    "@type": "Thing",
    "name": "{{ industry }}"
  }{% endif %}
}
</script>
