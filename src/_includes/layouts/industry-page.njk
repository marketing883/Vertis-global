---
layout: base.njk
---
{%- set accent = accent or "var(--color-pixel-yellow)" -%}

{# Hero #}
<section class="section pt-20 md:pt-28 pb-16 md:pb-24">
  <div class="wrapper grid-edit">
    <div class="col-span-12">
      <h1 class="font-display font-medium text-hero leading-[0.98] tracking-[-0.035em] text-balance reveal-mask">
        <span>{{ industry }}.</span>
        {% if tagline %}<span class="block italic" style="color: {{ accent }}">{{ tagline }}</span>{% endif %}
      </h1>
      {% if intro %}
        <p class="mt-8 md:mt-10 text-lg md:text-xl max-w-2xl text-ink-secondary reveal reveal-delay-2 pretty">{{ intro }}</p>
      {% endif %}
      <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-4 reveal reveal-delay-3">
        <a href="/contact/" class="btn btn-primary">
          Talk to us
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
        <a href="/industries/" class="btn btn-ghost">
          All industries
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{# Capabilities #}
{% if capabilities %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ accent }}">Capabilities</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ capabilitiesHeading or "Across the stack." }}</h2>
      {% if capabilitiesIntro %}
        <p class="mt-6 text-ink-secondary max-w-md pretty reveal reveal-delay-1">{{ capabilitiesIntro }}</p>
      {% endif %}
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <ul>
        {% for cap in capabilities %}
          <li class="reveal reveal-delay-{{ (loop.index0 % 4) + 1 }} py-8 md:py-10 border-t border-ink-primary {% if loop.last %}border-b{% endif %}">
            <h3 class="font-display font-medium text-2xl md:text-3xl leading-tight tracking-[-0.02em] flex items-start gap-3">
              <span class="shrink-0 mt-3" style="display:inline-block;width:.625rem;height:.625rem;background: {{ accent }}"></span>
              <span>{{ cap.title }}</span>
            </h3>
            <p class="mt-3 text-ink-secondary pretty pl-6">{{ cap.description }}</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

{# Typical outcomes #}
{% if outcomes %}
<section class="section section-statement">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-5">
      <span class="meta section-number reveal" style="--accent: {{ accent }}; color: var(--color-ink-inverse-secondary)">{{ outcomesEyebrow or "Typical outcomes" }}</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ outcomesHeading or "What we ship most." }}</h2>
      {% if outcomesIntro %}
        <p class="mt-6 text-ink-inverse-secondary max-w-md pretty reveal reveal-delay-1">{{ outcomesIntro }}</p>
      {% endif %}
    </div>
    <div class="col-span-12 md:col-span-7 md:pl-8">
      <ul class="grid grid-cols-1 gap-y-8 reveal reveal-delay-2">
        {% for o in outcomes %}
          <li class="flex items-start gap-4">
            <span class="shrink-0 mt-2" style="display:inline-block;width:.5rem;height:.5rem;background: {{ accent }}"></span>
            <div>
              <div class="font-display font-medium text-2xl md:text-3xl leading-tight tracking-[-0.02em]">{{ o.title }}</div>
              {% if o.description %}<p class="mt-2 text-ink-inverse-secondary pretty">{{ o.description }}</p>{% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

{# Stack #}
{% if technologies %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ accent }}">Stack</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ technologiesHeading or "Tools we see most." }}</h2>
      {% if technologiesIntro %}<p class="mt-6 text-ink-secondary max-w-md pretty reveal reveal-delay-1">{{ technologiesIntro }}</p>{% endif %}
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <ul class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-4 reveal reveal-delay-2">
        {% for t in technologies %}
          <li class="flex items-center gap-2 text-sm">
            <span class="shrink-0" style="display:inline-block;width:.375rem;height:.375rem;background: {{ accent }}"></span>
            {{ t }}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

{# FAQ #}
{% if faqs %}
<section class="section border-t border-ink-primary">
  <div class="wrapper grid-edit">
    <div class="col-span-12 md:col-span-4">
      <span class="meta section-number reveal" style="--accent: {{ accent }}">FAQ</span>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] mt-6 balance reveal">{{ faqsHeading or "Questions we get." }}</h2>
    </div>
    <div class="col-span-12 md:col-span-8 md:pl-8">
      <dl>
        {% for f in faqs %}
          <div class="reveal reveal-delay-{{ (loop.index0 % 4) + 1 }} py-6 md:py-8 border-t border-ink-primary {% if loop.last %}border-b{% endif %}">
            <dt class="font-display font-medium text-xl md:text-2xl leading-tight tracking-[-0.02em]">{{ f.q }}</dt>
            <dd class="mt-3 text-ink-secondary pretty max-w-3xl">{{ f.a }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
{% endif %}

{# How we work with you (pillar cross-refs) #}
{% if pillarRefs %}
<section class="section border-t border-ink-primary">
  <div class="wrapper">
    <div class="grid-edit mb-10 md:mb-12">
      <div class="col-span-12 md:col-span-4">
        <span class="meta section-number reveal" style="--accent: {{ accent }}">How we work here</span>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="font-display font-medium text-4xl md:text-5xl leading-[0.98] tracking-[-0.025em] balance reveal">{{ pillarRefsHeading or "Three ways to engage." }}</h2>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-ink-primary border border-ink-primary">
      {% for r in pillarRefs %}
        <a href="{{ r.url }}" class="bg-bg-base group block p-8 hover:bg-bg-subtle transition-colors duration-300 flex items-start justify-between gap-4 reveal reveal-delay-{{ loop.index }}">
          <div>
            <span class="meta text-ink-secondary">{{ r.kind }}</span>
            <div class="font-display font-medium text-2xl md:text-3xl leading-tight mt-2">{{ r.title }}</div>
            {% if r.blurb %}<p class="mt-3 text-sm text-ink-secondary pretty">{{ r.blurb }}</p>{% endif %}
          </div>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-2 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M2 8h12m0 0L9 3m5 5l-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# JSON-LD #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ industry }} technology services",
  "serviceType": "Industry technology services",
  "description": "{{ description }}",
  "provider": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "areaServed": "Global",
  "audience": {
    "@type": "Audience",
    "audienceType": "{{ industry }}"
  },
  "url": "{{ site.url }}{{ page.url }}"
}
</script>

{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for f in faqs %}{
      "@type": "Question",
      "name": "{{ f.q }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ f.a }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
