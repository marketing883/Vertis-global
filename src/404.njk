---
layout: base.njk
title: Page not found
description: That page is not here. Try the nav or head back home.
permalink: /404.html
eleventyExcludeFromCollections: true
showContactCta: false
robots: noindex,follow
---

<section class="section pt-24 md:pt-32 pb-24">
  <div class="wrapper grid-edit items-start">
    <div class="col-span-12">
      <h1 class="font-display font-medium text-hero leading-[0.98] tracking-[-0.035em] balance reveal">
        That page<br>
        <span class="italic text-ink-secondary">is not here.</span>
      </h1>
      <p class="mt-8 text-lg md:text-xl max-w-xl text-ink-secondary reveal reveal-delay-1">
        Maybe the link is old. Maybe the page moved. Good ways back:
      </p>
      <ul class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-px bg-ink-primary border border-ink-primary max-w-3xl reveal reveal-delay-2">
        {% for item in [
          { url: "/", label: "Home",     color: "var(--color-brand-blue)" },
          { url: "/services/", label: "Projects", color: "var(--color-pixel-cyan)" },
          { url: "/contact/", label: "Contact",  color: "var(--color-pixel-green)" }
        ] %}
          <li>
            <a href="{{ item.url }}" class="bg-bg-base group block p-6 md:p-8 hover:bg-bg-subtle transition-colors duration-300 flex items-center justify-between gap-4">
              <span class="flex items-center gap-3">
                <span style="display:inline-block;width:.5rem;height:.5rem;background: {{ item.color }}"></span>
                <span class="font-display font-medium text-2xl leading-none">{{ item.label }}</span>
              </span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
