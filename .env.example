# Copy to .env.local (on the server: in the app checkout, next to package.json).
# Without RESEND_API_KEY the site still runs; every email the forms would send
# is logged to the server console instead. See lib/email.ts.
RESEND_API_KEY=
MAIL_FROM=         # defaults to "Vertis Global <no-reply@vertisglobal.com>"; domain must be verified in Resend
MAIL_REPLY_TO=     # where replies to the visitor's thank-you go, defaults to info@vertisglobal.com
NOTIFY_TO=         # team inbox(es), comma separated, defaults to lohith.s@aciinfotech.com
NOTIFY_CC=         # cc on every lead, comma separated, defaults to krish.karanam@aciinfotech.com
